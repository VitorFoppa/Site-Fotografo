---
/*
 * Importa o Layout principal da aplicação.
 */
import Layout from "../layouts/Layout.astro";

/*
 * Importa o cabeçalho e o rodapé públicos.
 */
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout titulo="Fotógrafo | Momentos que permanecem">
  <Header />

  <main>
    <!-- HERO: apresentação principal -->
    <section class="hero">
      <div class="container hero-conteudo">
        <div class="hero-texto">
          <p class="hero-legenda" id="hero-legenda">FOTOGRAFIA</p>

          <h1 id="hero-titulo">Momentos que permanecem.</h1>

          <p class="hero-descricao" id="hero-descricao">
            Fotografando histórias, pessoas e momentos especiais para
            transformar lembranças em imagens.
          </p>

          <a href="/catalogo" class="botao" id="hero-botao">
            Ver catálogo
          </a>
        </div>

        <div class="hero-imagem">
          <div class="imagem-placeholder" id="placeholder-hero">
            FOTO PRINCIPAL
          </div>
        </div>
      </div>
    </section>

    <!-- SOBRE: apresentação do fotógrafo -->
    <section id="sobre" class="secao secao-alternativa">
      <div class="container sobre">
        <div class="sobre-imagem">
          <div class="imagem-placeholder" id="placeholder-sobre">
            FOTO DO FOTÓGRAFO
          </div>
        </div>

        <div class="sobre-conteudo">
          <p class="hero-legenda" id="sobre-legenda">SOBRE</p>

          <h2 class="titulo-secao" id="sobre-titulo">
            Fotografando histórias.
          </h2>

          <p class="sobre-texto" id="sobre-paragrafo-1">
            A fotografia é uma forma de preservar momentos que não podem
            ser repetidos.
          </p>

          <p class="sobre-texto" id="sobre-paragrafo-2">
            Meu objetivo é registrar cada história de maneira natural,
            criando imagens que transmitam a emoção daquele momento.
          </p>
        </div>
      </div>
    </section>

    <!-- PORTFÓLIO: galeria de trabalhos -->
    <section class="secao">
      <div class="container">
        <p class="hero-legenda">PORTFÓLIO</p>

        <h2 class="titulo-secao">Alguns trabalhos</h2>

        <p class="subtitulo-secao">
          Uma seleção de momentos registrados.
        </p>

        <div class="galeria" id="galeria-home">
          <div class="foto-placeholder">FOTO 01</div>
          <div class="foto-placeholder">FOTO 02</div>
          <div class="foto-placeholder">FOTO 03</div>
          <div class="foto-placeholder">FOTO 04</div>
          <div class="foto-placeholder">FOTO 05</div>
          <div class="foto-placeholder">FOTO 06</div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  /*
   * Cliente do Supabase já utilizado pelo projeto.
   */
  import { supabase } from "../lib/supabase";

  /*
   * Carrega os textos administráveis da página inicial.
   */
  async function carregarConteudoHome() {
    const { data, error } = await supabase
      .from("home_conteudo")
      .select("chave, valor");

    if (error) {
      console.error("Não foi possível carregar a Home:", error);
      return;
    }

    /*
     * Organiza os textos por chave para facilitar a consulta.
     */
    const conteudo = new Map(
      (data ?? []).map((registro) => [
        registro.chave,
        registro.valor,
      ])
    );

    /*
     * Atualiza os elementos sem substituir textos
     * quando o valor do banco estiver vazio.
     */
    function atualizarTexto(id: string, chave: string) {
      const elemento = document.getElementById(id);
      const valor = conteudo.get(chave);

      if (
        elemento &&
        typeof valor === "string" &&
        valor.trim()
      ) {
        elemento.textContent = valor;
      }
    }

    atualizarTexto("hero-legenda", "hero_legenda");
    atualizarTexto("hero-titulo", "hero_titulo");
    atualizarTexto("hero-descricao", "hero_descricao");

    atualizarTexto("sobre-legenda", "sobre_legenda");
    atualizarTexto("sobre-titulo", "sobre_titulo");
    atualizarTexto("sobre-paragrafo-1", "sobre_paragrafo_1");
    atualizarTexto("sobre-paragrafo-2", "sobre_paragrafo_2");

    /*
     * Atualiza o texto e o destino do botão principal.
     * Por segurança, aceita somente caminhos internos.
     */
    const textoBotao = conteudo.get("hero_botao_texto");
    const linkBotao = conteudo.get("hero_botao_link");
    const botao = document.getElementById("hero-botao");

    if (
      botao instanceof HTMLAnchorElement &&
      typeof textoBotao === "string" &&
      textoBotao.trim()
    ) {
      botao.textContent = textoBotao;
    }

    if (
      botao instanceof HTMLAnchorElement &&
      typeof linkBotao === "string" &&
      /^\/(?!\/)/.test(linkBotao.trim())
    ) {
      botao.setAttribute("href", linkBotao.trim());
    }

    /*
     * Atualiza o título e a descrição para mecanismos de busca.
     */
    const tituloSeo = conteudo.get("seo_titulo");
    const descricaoSeo = conteudo.get("seo_descricao");

    if (typeof tituloSeo === "string" && tituloSeo.trim()) {
      document.title = tituloSeo.trim();
    }

    if (typeof descricaoSeo === "string" && descricaoSeo.trim()) {
      let metaDescricao = document.querySelector(
        'meta[name="description"]'
      );

      if (!metaDescricao) {
        metaDescricao = document.createElement("meta");
        metaDescricao.setAttribute("name", "description");
        document.head.appendChild(metaDescricao);
      }

      metaDescricao.setAttribute("content", descricaoSeo.trim());
    }
  }

  /*
   * Cria uma imagem HTML usando os dados da tabela home_fotos.
   */
  function criarImagem(
    foto: {
      titulo: string | null;
      descricao: string | null;
      url_imagem: string;
    },
    classe: string
  ) {
    const imagem = document.createElement("img");

    imagem.src = foto.url_imagem;
    imagem.alt = foto.descricao || foto.titulo || "Fotografia";
    imagem.className = classe;
    imagem.loading = "lazy";
    imagem.decoding = "async";

    /*
     * Se a URL estiver quebrada, mostra um aviso no console
     * e evita deixar um ícone de imagem quebrada na página.
     */
    imagem.addEventListener("error", () => {
      console.error("Não foi possível carregar a imagem:", imagem.src);
      imagem.remove();
    });

    return imagem;
  }

  /*
   * Carrega as imagens públicas e ativas da página inicial.
   */
  async function carregarImagensHome() {
    const { data, error } = await supabase
      .from("home_fotos")
      .select("categoria, titulo, descricao, url_imagem, ordem")
      .eq("ativo", true)
      .order("ordem", { ascending: true });

    if (error) {
      console.error("Erro ao carregar imagens da Home:", error);
      return;
    }

    const imagens = data ?? [];

    /*
     * Foto principal da apresentação.
     * Seleciona a primeira imagem ativa da categoria hero.
     */
    const fotoHero = imagens.find(
      (foto) => foto.categoria === "hero"
    );

    const placeholderHero = document.getElementById("placeholder-hero");

    if (fotoHero && placeholderHero) {
      const imagem = criarImagem(fotoHero, "imagem-home");

      imagem.loading = "eager";
      imagem.setAttribute("fetchpriority", "high");

      placeholderHero.replaceWith(imagem);
    }

    /*
     * Foto da seção Sobre.
     */
    const fotoSobre = imagens.find(
      (foto) => foto.categoria === "sobre"
    );

    const placeholderSobre = document.getElementById("placeholder-sobre");

    if (fotoSobre && placeholderSobre) {
      placeholderSobre.replaceWith(
        criarImagem(fotoSobre, "imagem-home")
      );
    }

    /*
     * Galeria do portfólio.
     * Exibe no máximo seis imagens ativas, em ordem crescente.
     */
    const galeria = document.getElementById("galeria-home");

    if (galeria) {
      const fotosPortfolio = imagens
        .filter((foto) => foto.categoria === "portfolio")
        .slice(0, 6);

      const placeholders = Array.from(
        galeria.querySelectorAll(".foto-placeholder")
      );

      fotosPortfolio.forEach((foto, indice) => {
        const placeholder = placeholders[indice];

        if (placeholder) {
          placeholder.replaceWith(
            criarImagem(foto, "foto-portfolio")
          );
        }
      });
    }
  }

  /*
   * Inicia o carregamento do conteúdo e das imagens.
   */
  void carregarConteudoHome();
  void carregarImagensHome();
</script>

<style>
  /*
   * HERO
   */
  .hero {
    min-height: 720px;
    display: flex;
    align-items: center;
  }

  .hero-conteudo {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 70px;
    align-items: center;
  }

  .hero-texto {
    max-width: 450px;
  }

  .hero-legenda {
    margin-bottom: 15px;
    color: var(--cor-destaque);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .hero h1 {
    margin-bottom: 28px;
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .hero-descricao {
    margin-bottom: 32px;
    color: var(--cor-texto-secundario);
    font-size: 1.05rem;
  }

  /*
   * IMAGENS PRINCIPAIS
   */
  .hero-imagem {
    height: 620px;
    overflow: hidden;
  }

  .imagem-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--cor-fundo-secundario);
    color: var(--cor-texto-secundario);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }

  /*
   * Imagens carregadas do Supabase Storage.
   *
   * IMPORTANTE: estas classes são aplicadas via JavaScript
   * (document.createElement), por isso precisam de :global().
   * Sem isso, o CSS scoped do Astro não alcança os elementos
   * criados dinamicamente e as fotos ficam com tamanho natural.
   */
  :global(.imagem-home) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
   * SOBRE
   */
  .sobre {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    align-items: center;
  }

  .sobre-imagem {
    height: 500px;
    overflow: hidden;
  }

  .sobre-conteudo {
    max-width: 500px;
  }

  .sobre-texto {
    margin-bottom: 20px;
    color: var(--cor-texto-secundario);
    font-size: 1.05rem;
  }

  /*
   * GALERIA
   * Grid com linhas travadas: todas as células têm exatamente
   * a mesma altura, independente do tamanho original da foto.
   */
  .galeria {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 1fr;
    gap: 20px;
  }

  .foto-placeholder {
    width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--cor-fundo-secundario);
    color: var(--cor-texto-secundario);
    font-size: 0.85rem;
    transition: transform 0.3s ease;
  }

  .foto-placeholder:hover {
    transform: translateY(-4px);
  }

  /*
   * Fotografias reais do portfólio.
   *
   * Preenche 100% da célula do grid: largura e altura sempre iguais
   * entre os cards. object-fit: cover corta sem distorcer.
   *
   * IMPORTANTE: o :global() é obrigatório aqui, pois a imagem é
   * criada via JavaScript e não recebe o atributo de escopo do Astro.
   */
  :global(.foto-portfolio) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
    transition: transform 0.3s ease;
  }

  :global(.foto-portfolio:hover) {
    transform: translateY(-4px);
  }

  /*
   * RESPONSIVIDADE
   */
  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 80px 0;
    }

    .hero-conteudo {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .hero-imagem {
      height: 450px;
    }

    .sobre {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .sobre-imagem {
      height: 400px;
    }

    .galeria {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 1fr;
    }
  }

  /*
   * CELULARES PEQUENOS
   */
  @media (max-width: 480px) {
    .galeria {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }

    :global(.foto-portfolio) {
      height: auto;
    }

    .hero h1 {
      font-size: 3rem;
    }
  }
</style>