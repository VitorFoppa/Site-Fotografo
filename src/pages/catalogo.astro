---
/*
 * Importa o Layout principal.
 */
import Layout from "../layouts/Layout.astro";

/*
 * Importa o cabeçalho e o rodapé.
 */
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

/*
 * O PlanoCard será criado no navegador usando os dados
 * recebidos do Supabase. Por isso, não importamos aqui
 * o componente Astro PlanoCard.
 */
---

<Layout titulo="Catálogo | Fotógrafo">
  <Header />

  <main>
    <!-- Cabeçalho do catálogo -->
    <section class="catalogo-header">
      <div class="container">
        <p class="hero-legenda">CATÁLOGO</p>

        <h1>Encontre o plano ideal para seu momento.</h1>

        <p class="catalogo-introducao">
          Escolha a opção que melhor combina com o que você
          deseja registrar. Se precisar, entre em contato para
          montarmos uma proposta personalizada.
        </p>
      </div>
    </section>

    <!-- Planos carregados do Supabase -->
    <section class="secao">
      <div class="container">
        <div
          id="mensagem-catalogo"
          class="mensagem-catalogo"
          role="status"
          aria-live="polite"
        >
          Carregando planos...
        </div>

        <div id="lista-planos" class="planos"></div>
      </div>
    </section>

    <!-- Contato -->
    <section id="contato" class="contato">
      <div class="container contato-conteudo">
        <p class="hero-legenda">VAMOS CONVERSAR?</p>

        <h2>Vamos registrar seu próximo momento?</h2>

        <p>
          Entre em contato para tirar dúvidas ou solicitar
          uma proposta personalizada.
        </p>

        <a href="#" class="botao">
          Entrar em contato
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  /*
   * Cliente Supabase já utilizado pelo painel administrativo.
   */
  import { supabase } from "../lib/supabase";

  /*
   * Elementos onde os planos e as mensagens serão exibidos.
   */
  const listaPlanos = document.querySelector<HTMLDivElement>("#lista-planos");
  const mensagemCatalogo = document.querySelector<HTMLDivElement>(
    "#mensagem-catalogo"
  );

  /*
   * Representa um plano cadastrado no banco.
   */
  type Plano = {
    id: string;
    nome: string;
    descricao: string;
    preco: number | string;
    destaque: boolean;
    ativo: boolean;
    ordem: number;
    foto_key: string | null;
  };

  /*
   * Representa um benefício associado a um plano.
   */
  type ItemPlano = {
    id: string;
    plano_id: string;
    descricao: string;
    ordem: number;
  };

  /*
   * Formata o preço para o padrão monetário brasileiro.
   */
  function formatarPreco(preco: number | string): string {
    return new Intl.NumberFormat("pt-BR", {
      style: "currency",
      currency: "BRL",
    }).format(Number(preco));
  }

  /*
   * Cria um elemento HTML e define seu texto com segurança.
   *
   * Usamos textContent em vez de inserir dados do banco
   * diretamente como HTML.
   */
  function criarElemento<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    classe: string,
    texto?: string
  ): HTMLElementTagNameMap[K] {
    const elemento = document.createElement(tag);
    elemento.className = classe;

    if (texto !== undefined) {
      elemento.textContent = texto;
    }

    return elemento;
  }

  /*
   * Monta o cartão de um plano.
   */
  function criarCartaoPlano(
    plano: Plano,
    itens: ItemPlano[]
  ): HTMLElement {
    const cartao = criarElemento("article", "plano-card");

    /*
     * Aplica uma classe extra aos planos em destaque.
     */
    if (plano.destaque) {
      cartao.classList.add("plano-card-destaque");

      cartao.appendChild(
        criarElemento("span", "plano-selo", "Destaque")
      );
    }

    /*
     * Área da foto.
     * Todos os cards reservam o mesmo espaço, mesmo sem imagem.
     */
    const areaFoto = criarElemento("div", "plano-foto-area");

    if (plano.foto_key) {
      const imagem = criarElemento("img", "plano-foto");

      imagem.src = supabase.storage
        .from("fotos-catalogo")
        .getPublicUrl(plano.foto_key).data.publicUrl;

      imagem.alt = `Foto do plano ${plano.nome}`;
      imagem.loading = "lazy";

      areaFoto.appendChild(imagem);
    }

    cartao.appendChild(areaFoto);

    /*
     * Nome e descrição.
     */
    cartao.appendChild(
      criarElemento("h2", "plano-nome", plano.nome)
    );

    cartao.appendChild(
      criarElemento("p", "plano-descricao", plano.descricao || "")
    );

    /*
     * Preço.
     */
    const areaPreco = criarElemento("div", "plano-preco");

    areaPreco.appendChild(
      criarElemento("span", "plano-preco-legenda", "Investimento")
    );

    areaPreco.appendChild(
      criarElemento("p", "plano-preco-valor", formatarPreco(plano.preco))
    );

    cartao.appendChild(areaPreco);

    /*
     * Lista de benefícios.
     */
    const listaItens = criarElemento("ul", "plano-itens");

    for (const item of itens) {
      listaItens.appendChild(
        criarElemento("li", "", item.descricao)
      );
    }

    if (itens.length === 0) {
      listaItens.appendChild(
        criarElemento(
          "li",
          "plano-sem-itens",
          "Consulte os detalhes deste plano."
        )
      );
    }

    cartao.appendChild(listaItens);

    /*
     * Link para contato.
     * O destino poderá ser configurado pelo administrador
     * em uma etapa futura.
     */
    const contato = criarElemento("a", "botao", "Tenho interesse");

    contato.href = "#contato";
    cartao.appendChild(contato);

    return cartao;
  }

  /*
   * Busca os planos ativos e seus respectivos benefícios.
   */
  async function carregarPlanos(): Promise<void> {
    if (!listaPlanos || !mensagemCatalogo) {
      return;
    }

    try {
      /*
       * Primeiro buscamos somente os planos ativos.
       */
      const { data: planos, error: erroPlanos } = await supabase
        .from("planos")
        .select(
          "id, nome, descricao, preco, destaque, ativo, ordem, foto_key"
        )
        .eq("ativo", true)
        .order("ordem", { ascending: true });

      if (erroPlanos) {
        throw erroPlanos;
      }

      /*
       * Se não houver planos ativos, mostramos uma mensagem.
       */
      if (!planos || planos.length === 0) {
        mensagemCatalogo.textContent =
          "No momento, não há planos disponíveis. Entre em contato para consultar opções personalizadas.";

        return;
      }

      /*
       * Buscamos os benefícios associados aos planos ativos.
       */
      const idsPlanos = planos.map((plano) => plano.id);

      const { data: itens, error: erroItens } = await supabase
        .from("plano_itens")
        .select("id, plano_id, descricao, ordem")
        .in("plano_id", idsPlanos)
        .order("ordem", { ascending: true });

      if (erroItens) {
        throw erroItens;
      }

      /*
       * Separamos os benefícios por plano e criamos os cartões.
       */
      const itensPorPlano = new Map<string, ItemPlano[]>();

      for (const item of (itens ?? []) as ItemPlano[]) {
        const itensExistentes = itensPorPlano.get(item.plano_id) ?? [];

        itensExistentes.push(item);
        itensPorPlano.set(item.plano_id, itensExistentes);
      }

      const fragmento = document.createDocumentFragment();

      for (const plano of planos as Plano[]) {
        const itensPlano = itensPorPlano.get(plano.id) ?? [];

        fragmento.appendChild(criarCartaoPlano(plano, itensPlano));
      }

      listaPlanos.replaceChildren(fragmento);
      mensagemCatalogo.textContent = "";
      mensagemCatalogo.hidden = true;
    } catch (erro) {
      console.error("Erro ao carregar catálogo:", erro);

      mensagemCatalogo.textContent =
        "Não foi possível carregar os planos agora. Tente novamente em instantes.";

      mensagemCatalogo.hidden = false;
    }
  }

  /*
   * Inicia o carregamento do catálogo.
   */
  carregarPlanos();
</script>

<!--
  IMPORTANTE: is:global é obrigatório aqui.
  Os cartões são criados via JavaScript (document.createElement),
  então não recebem o atributo de escopo do Astro. Sem is:global,
  este CSS não seria aplicado aos cards.
-->
<style is:global>
  /*
   * Cabeçalho do catálogo.
   */
  .catalogo-header {
    padding: 120px 0 80px;
  }

  .catalogo-header h1 {
    max-width: 700px;
    margin-bottom: 25px;
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .catalogo-introducao {
    max-width: 600px;
    color: var(--cor-texto-secundario);
    font-size: 1.05rem;
  }

  /*
   * Grade dos cartões.
   */
  .planos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
    align-items: stretch;
  }

  /*
   * Cartão do plano.
   */
  .plano-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    padding: 30px;
    box-sizing: border-box;
    background: var(--cor-branco);
    border: 1px solid #e6e1db;
    border-radius: 12px;
  }

  .plano-card-destaque {
    border: 2px solid var(--cor-destaque);
  }

  .plano-selo {
    align-self: flex-start;
    margin-bottom: 15px;
    padding: 6px 10px;
    background: var(--cor-fundo-secundario);
    color: var(--cor-destaque-hover);
    border-radius: 5px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  /*
   * Área reservada para a foto em todos os cards.
   * Altura fixa garante alinhamento mesmo com imagens
   * de tamanhos diferentes.
   */
  .plano-foto-area {
    width: 100%;
    height: 240px;
    margin-bottom: 20px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 8px;
    background: var(--cor-fundo-secundario);
  }

  /*
   * A imagem preenche a área sem distorção.
   */
  .plano-foto {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .plano-nome {
    margin-bottom: 12px;
    font-size: 1.6rem;
    font-weight: 500;
  }

  .plano-descricao {
    margin-bottom: 25px;
    color: var(--cor-texto-secundario);
    line-height: 1.6;
  }

  .plano-preco {
    margin-bottom: 25px;
    padding-bottom: 20px;
    border-bottom: 1px solid #e6e1db;
  }

  .plano-preco-legenda {
    color: var(--cor-texto-secundario);
    font-size: 0.85rem;
  }

  .plano-preco-valor {
    margin-top: 5px;
    font-size: 1.8rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .plano-itens {
    display: grid;
    gap: 12px;
    margin: 0 0 30px;
    padding: 0;
    list-style: none;
  }

  .plano-itens li {
    position: relative;
    padding-left: 22px;
    line-height: 1.5;
  }

  .plano-itens li::before {
    position: absolute;
    left: 0;
    content: "✓";
    color: var(--cor-destaque);
    font-weight: 700;
  }

  .plano-sem-itens {
    color: var(--cor-texto-secundario);
  }

  /*
   * O botão gruda no rodapé do card graças ao
   * margin-top: auto no flex column.
   */
  .plano-card .botao {
    display: inline-block;
    margin-top: auto;
    text-align: center;
    text-decoration: none;
  }

  /*
   * Mensagens de carregamento, catálogo vazio e erros.
   */
  .mensagem-catalogo {
    margin-bottom: 25px;
    color: var(--cor-texto-secundario);
    text-align: center;
  }

  .mensagem-catalogo[hidden] {
    display: none;
  }

  /*
   * Seção de contato.
   */
  .contato {
    padding: 100px 0;
    background-color: var(--cor-fundo-secundario);
  }

  .contato-conteudo {
    max-width: 700px;
    text-align: center;
  }

  .contato h2 {
    margin-bottom: 20px;
    font-size: clamp(2.3rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1;
  }

  .contato p:not(.hero-legenda) {
    margin-bottom: 30px;
    color: var(--cor-texto-secundario);
  }

  /*
   * Responsividade.
   */
  @media (max-width: 900px) {
    .planos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .catalogo-header {
      padding: 80px 0 50px;
    }

    .planos {
      grid-template-columns: 1fr;
    }

    .plano-card {
      padding: 24px;
    }

    .plano-foto-area {
      height: 200px;
    }

    .contato {
      padding: 80px 0;
    }
  }
</style>